<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>OPEN RADAR</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background: #f4f6f8;
  color: #222;
}

header {
  background: #111;
  color: white;
  padding: 24px 16px;
}

header h1 {
  margin: 0;
  font-size: 30px;
}

header p {
  margin: 6px 0 0;
  color: #ccc;
}

main {
  max-width: 900px;
  margin: auto;
  padding: 16px;
}

.card {
  background: white;
  border-radius: 14px;
  padding: 18px;
  margin-bottom: 14px;
  box-shadow: 0 2px 8px rgba(0,0,0,.08);
}

input,
select {
  width: 100%;
  padding: 13px;
  margin: 6px 0 12px;
  border: 1px solid #ccc;
  border-radius: 9px;
  font-size: 16px;
}

button,
.button {
  display: inline-block;
  border: 0;
  border-radius: 9px;
  padding: 11px 15px;
  margin: 5px 5px 5px 0;
  background: #222;
  color: white;
  text-decoration: none;
  font-size: 15px;
  cursor: pointer;
}

.back {
  background: #666;
}

.badge {
  display: inline-block;
  background: #eee;
  border-radius: 20px;
  padding: 5px 9px;
  margin: 2px;
  font-size: 12px;
}

.small {
  color: #666;
  font-size: 13px;
  line-height: 1.7;
}

.hidden {
  display: none;
}

.notice {
  background: #fff8df;
  border: 1px solid #eadb9a;
  border-radius: 10px;
  padding: 12px;
  margin-top: 14px;
  font-size: 13px;
}

.error {
  color: #b00020;
  font-weight: bold;
}

@media(max-width:600px) {
  header h1 {
    font-size: 26px;
  }

  .card {
    padding: 15px;
  }

  button,
  .button {
    width: 100%;
    margin: 5px 0;
  }
}
</style>
</head>

<body>

<header>
  <h1>OPEN RADAR</h1>
  <p>公開情報を、見つけやすく。</p>
</header>

<main>

<section id="listPage">

  <div class="card">

    <h2>公開情報を探す</h2>

    <input
      id="keyword"
      type="search"
      placeholder="施設名・地域・キーワード"
      oninput="renderList()"
    >

    <select id="prefecture" onchange="renderList()">
      <option value="">都道府県：すべて</option>
    </select>

    <select id="city" onchange="renderList()">
      <option value="">市町村：すべて</option>
    </select>

    <select id="category" onchange="renderList()">
      <option value="">分野：すべて</option>
    </select>

    <p id="status" class="small">
      データを読み込んでいます…
    </p>

  </div>

  <div id="results"></div>

  <div class="card">

    <h3>OPEN RADARについて</h3>

    <p class="small">
      OPEN RADARは、国・地方自治体等が公開している情報を、
      公開元の利用条件を確認したうえで整理し、
      見つけやすくするための情報サービスです。
    </p>

    <p class="small">
      OPEN RADARが営業先、必要な工事・サービス、
      将来の需要等を判断・推奨するものではありません。
      情報の利用・判断は利用者自身で行ってください。
    </p>

  </div>

</section>


<section id="detailPage" class="hidden">

  <div class="card">

    <button class="back" onclick="showList()">
      ← 一覧に戻る
    </button>

    <div id="detail"></div>

  </div>

</section>

</main>


<script>

let datasets = [];


/* ==============================
   データ読み込み
============================== */

async function loadData() {

  const status = document.getElementById("status");

  try {

    const response = await fetch(
      "./otsu-data.json?time=" + Date.now()
    );

    if (!response.ok) {
      throw new Error(
        "HTTP " + response.status
      );
    }

    const json = await response.json();

    if (!json || !Array.isArray(json.datasets)) {
      throw new Error(
        "datasets がありません"
      );
    }

    datasets = json.datasets;

    buildFilters();

    renderList();

  } catch (error) {

    console.error(error);

    status.innerHTML =
      '<span class="error">' +
      'データを読み込めませんでした。' +
      '</span>';

  }

}


/* ==============================
   絞り込み項目
============================== */

function buildFilters() {

  fillSelect(
    "prefecture",
    datasets.map(x => x.prefecture)
  );

  fillSelect(
    "city",
    datasets.map(x => x.city)
  );

  fillSelect(
    "category",
    datasets.map(x => x.category)
  );

}


function fillSelect(id, values) {

  const select =
    document.getElementById(id);

  const unique = [
    ...new Set(
      values.filter(Boolean)
    )
  ];

  unique.forEach(value => {

    const option =
      document.createElement("option");

    option.value = value;
    option.textContent = value;

    select.appendChild(option);

  });

}


/* ==============================
   一覧表示
============================== */

function renderList() {

  const keyword =
    document.getElementById("keyword")
      .value
      .trim()
      .toLowerCase();

  const prefecture =
    document.getElementById("prefecture")
      .value;

  const city =
    document.getElementById("city")
      .value;

  const category =
    document.getElementById("category")
      .value;

  const results =
    document.getElementById("results");


  const found =
    datasets
      .map((item, index) => ({
        item,
        index
      }))
      .filter(entry => {

        const x = entry.item;

        const text = [
          x.title,
          x.description,
          x.category,
          x.prefecture,
          x.city,
          x.publisher
        ]
        .filter(Boolean)
        .join(" ")
        .toLowerCase();


        return (

          (!keyword ||
           text.includes(keyword))

          &&

          (!prefecture ||
           x.prefecture === prefecture)

          &&

          (!city ||
           x.city === city)

          &&

          (!category ||
           x.category === category)

        );

      });


  document.getElementById("status")
    .textContent =
    found.length + "件の公開情報";


  results.innerHTML = "";


  if (found.length === 0) {

    results.innerHTML = `
      <div class="card">
        該当する公開情報はありません。
      </div>
    `;

    return;

  }


  found.forEach(entry => {

    const x = entry.item;

    const div =
      document.createElement("div");

    div.className = "card";


    div.innerHTML = `

      <span class="badge">
        ${safe(x.category || "未分類")}
      </span>

      <span class="badge">
        ${safe(x.format || "形式不明")}
      </span>

      <h2>
        ${safe(x.title || "名称未設定")}
      </h2>

      <p class="small">

        地域：
        ${safe(x.prefecture || "")}
        ${safe(x.city || "")}
        <br>

        公開元：
        ${safe(x.publisher || "")}
        <br>

        データ時点：
        ${safe(x.data_as_of || "記載なし")}
        <br>

        公開・更新日：
        ${safe(x.published || "記載なし")}

      </p>

      <button onclick="showDetail(${entry.index})">
        詳細を見る
      </button>

    `;


    results.appendChild(div);

  });

}


/* ==============================
   詳細
============================== */

function showDetail(index) {

  const x = datasets[index];

  if (!x) {
    return;
  }


  document.getElementById("listPage")
    .classList.add("hidden");

  document.getElementById("detailPage")
    .classList.remove("hidden");


  let links = "";


  if (x.file_url) {

    links += `

      <a
        class="button"
        href="${safeURL(x.file_url)}"
        target="_blank"
        rel="noopener"
      >
        📊 公開データを開く
      </a>

    `;

  }


  if (x.source_url) {

    links += `

      <a
        class="button"
        href="${safeURL(x.source_url)}"
        target="_blank"
        rel="noopener"
      >
        🌐 公開元の公式ページ
      </a>

    `;

  }


  document.getElementById("detail")
    .innerHTML = `

      <span class="badge">
        ${safe(x.category || "未分類")}
      </span>

      <span class="badge">
        ${safe(x.format || "形式不明")}
      </span>

      <h2>
        ${safe(x.title || "名称未設定")}
      </h2>

      <p>

        <strong>都道府県：</strong>
        ${safe(x.prefecture || "―")}
        <br><br>

        <strong>市町村：</strong>
        ${safe(x.city || "―")}
        <br><br>

        <strong>公開元：</strong>
        ${safe(x.publisher || "―")}
        <br><br>

        <strong>データ時点：</strong>
        ${safe(x.data_as_of || "―")}
        <br><br>

        <strong>公開・更新日：</strong>
        ${safe(x.published || "―")}
        <br><br>

        <strong>形式：</strong>
        ${safe(x.format || "―")}

      </p>

      <hr>

      <h3>資料・データ</h3>

      ${links}

      <div class="notice">

        OPEN RADARは公開元の情報を
        整理して表示しています。

        最新情報・正確性については、
        必ず公開元の公式情報をご確認ください。

      </div>

      <p class="small">

        ${safe(x.description || "")}

      </p>

  `;


  window.scrollTo({
    top: 0,
    behavior: "smooth"
  });

}


/* ==============================
   一覧へ戻る
============================== */

function showList() {

  document.getElementById("detailPage")
    .classList.add("hidden");

  document.getElementById("listPage")
    .classList.remove("hidden");

  window.scrollTo({
    top: 0,
    behavior: "smooth"
  });

}


/* ==============================
   安全表示
============================== */

function safe(value) {

  return String(value ?? "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");

}


function safeURL(value) {

  const url =
    String(value || "").trim();

  if (
    url.startsWith("https://") ||
    url.startsWith("http://")
  ) {
    return url.replace(/"/g, "%22");
  }

  return "#";

}


/* ==============================
   起動
============================== */

loadData();

</script>

</body>
</html>
